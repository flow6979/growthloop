# Model providers: set any you have. The UI shows which are available and lets you pick per tier/role.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Live web search for the Market Researcher (optional, one of)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Product metrics: Firebase service account JSON with read access (for the Firestore metrics adapter)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Langfuse tracing (self-hosted or cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
